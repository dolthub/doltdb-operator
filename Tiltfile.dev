# Local setup
make_deps = ['Makefile', 'make']
codegen_deps = make_deps + ['api']
istio_enabled = os.getenv('ISTIO_ENABLED') == 'true'

# Ignore generated output to prevent code generation from retriggering itself.
codegen_ignores = ['api/v1alpha/zz_generated.deepcopy.go']

local_resource('Kustomize installation', cmd='make kustomize', deps=make_deps, labels=['setup'])
local_resource(
  'DeepCopy generation',
  cmd='make generate',
  deps=codegen_deps,
  ignore=codegen_ignores,
  labels=['setup'],
)
# make install runs make manifests before applying the CRDs.
local_resource(
  'CRD installation',
  cmd='make install',
  deps=codegen_deps,
  ignore=codegen_ignores,
  resource_deps=['Kustomize installation', 'DeepCopy generation'],
  labels=['setup'],
)

if istio_enabled:
  local_resource(
    'Istio installation',
    cmd='make install-istio',
    deps=['Makefile', 'make/dev.mk'],
    resource_deps=['CRD installation'],
    labels=['setup'],
  )

operator_image = os.getenv('LOCAL_DEV_OPERATOR_IMAGE')
if operator_image:
  warn('Using external operator image %s; local build skipped' % operator_image)
else:
  operator_image = 'localhost:5000/doltdb-operator:local'
  docker_build(operator_image, '.', dockerfile='Dockerfile')

# Cluster prerequisites
k8s_yaml([
  'hack/manifests/storageclass.yaml',
  'hack/manifests/e2e/snapshot.storage.k8s.io_volumesnapshots.yaml',
  'hack/manifests/doltdb-secret.yaml',
])
k8s_resource(
  objects=[
    'standard-resize:storageclass',
    'volumesnapshots.snapshot.storage.k8s.io:customresourcedefinition',
    'dolt-credentials:secret',
  ],
  new_name='DoltDB Prerequisites',
  labels=['platform'],
)

# Operator
operator_yaml = kustomize('config/default')
operator_manifests = decode_yaml_stream(operator_yaml)
for manifest in operator_manifests:
  if manifest['kind'] == 'Deployment':
    manifest['spec']['replicas'] = 2
    for container in manifest['spec']['template']['spec']['containers']:
      if container['name'] == 'manager':
        container['image'] = operator_image
  if istio_enabled and manifest['kind'] == 'Namespace':
    manifest['metadata']['labels']['istio-injection'] = 'enabled'
operator_yaml = encode_yaml_stream(operator_manifests)
k8s_yaml(operator_yaml)
# Tilt already associates the Deployment and Service with the operator workload.
operator_objects = [
  '%s:%s' % (obj['metadata']['name'], obj['kind'].lower())
  for obj in decode_yaml_stream(operator_yaml)
  if obj['kind'] not in ['Deployment', 'Service']
]
operator_resource_deps = ['CRD installation']
if istio_enabled:
  operator_resource_deps = operator_resource_deps + ['Istio installation']
k8s_resource(
  workload='doltdb-operator-controller-manager',
  objects=operator_objects,
  new_name='DoltDB Operator',
  resource_deps=operator_resource_deps,
  labels=['platform'],
)

# DoltDB cluster
dolt_engine_version = os.getenv('LOCAL_DEV_DOLTDB_ENGINE_VERSION')
dolt_manifests = decode_yaml_stream(read_file('hack/manifests/doltdb-local-dev.yaml'))
for manifest in dolt_manifests:
  if manifest['kind'] == 'DoltDB' and dolt_engine_version:
    manifest['spec']['engineVersion'] = dolt_engine_version
k8s_yaml(encode_yaml_stream(dolt_manifests))
k8s_resource(
  new_name='DoltDB Cluster',
  objects=['dolt:doltdb'],
  resource_deps=['DoltDB Prerequisites', 'DoltDB Operator'],
  labels=['database'],
)
